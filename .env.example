# DOR101 Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Database Connection (optional — not required for desktop app)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# No API keys are required. All data sources use free, public APIs.

# U.S. Census Bureau API key — OPTIONAL, but recommended on a deployed server.
#
# Since 12 May 2026 api.census.gov rejects every request that does not carry a
# key (it answers the data/missing_key.html page instead of JSON). DOR101 reads
# the same ACS tables from data.census.gov without one, so the market page and
# the home-page rent card work with nothing set — but with a key the fastest
# reader is used and one request replaces eight.
#
# Free, no organisation required: https://api.census.gov/data/key_signup.html
# On Vercel: Project → Settings → Environment Variables → CENSUS_API_KEY.
# CENSUS_API_KEY=
