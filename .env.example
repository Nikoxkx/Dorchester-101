# DOR101 Environment Variables
# Copy this file to .env and fill in your values. All are OPTIONAL.
# On Vercel: Project → Settings → Environment Variables.

# ── Required in production ──────────────────────────────────────────────
# Canonical origin for sitemap, robots, OG images, JSON-LD and canonical links.
# Without this, those all point at http://localhost:3000 and Google ignores them.
# On Vercel set to your production URL:
#   https://dorchester-101.vercel.app   (default until you own a domain)
#   or https://dorchester101.org       (once you add a custom domain)
NEXT_PUBLIC_SITE_URL=https://dorchester-101.vercel.app

# ── Recommended ───────────────────────────────────────────────────────────
# U.S. Census Bureau API key — optional but 8× faster on production.
# Since 12 May 2026 api.census.gov requires a key (else HTML notice).
# Free, no org: https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=

# Cron protection — Vercel auto-sends Authorization: Bearer <CRON_SECRET> for cron hits.
# If not set, cron endpoints are public (safe: they only warm a cache).
# CRON_SECRET=

# ── Search indexing ─────────────────────────────────────────────────────
# After you verify the domain in Google Search Console (HTML tag method),
# paste the token here (the 43-char string from the tag) and redeploy:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Same for Bing:
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Contact (optional) ──────────────────────────────────────────────────
# A real mailbox for Report-a-problem; if empty we link to GitHub Issues.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_URL=

# ── Database (optional — not required for website/PWA) ─────────────────
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
